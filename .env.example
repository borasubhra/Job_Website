# ---- Database (Docker) ----
POSTGRES_DB=jobportal
POSTGRES_USER=jobadmin
POSTGRES_PASSWORD=ChangeMe_Strong123
POSTGRES_PORT=5432
# DB_HOST is "db" inside Docker (set automatically); "localhost" if you run PHP directly on Windows
DB_HOST=localhost

# ---- pgAdmin (DB web UI) ----
PGADMIN_EMAIL=admin@jobportal.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- Website ----
APP_PORT=8080
SITE_NAME=JobPortal

# ---- Automatic job updates ----
FETCH_CRON=0 6,18 * * *
FETCH_TIMEZONE=Asia/Kolkata
FETCH_ON_START=true
MAX_NEW_PER_SOURCE=40
CRAWLER_USER_AGENT=JobPortalBot/1.0 (+contact: you@yourdomain.com)

# ---- All India jobs (free key: https://developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
